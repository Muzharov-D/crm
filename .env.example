DOMAIN=crm.example.ru
# login:password:role entries separated by semicolons.
# Roles: admin (full access + audit), manager (editor), viewer (read-only).
# Legacy login:password entries are admins. Replace every example password.
CRM_USERS=owner:replace-me:admin;sales:replace-me:manager;guest:replace-me:viewer
# Required in production; generate a long random value.
SESSION_SECRET=
POSTGRES_PASSWORD=
