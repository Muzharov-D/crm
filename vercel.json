{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/jobs/overdue",
      "schedule": "0 * * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
